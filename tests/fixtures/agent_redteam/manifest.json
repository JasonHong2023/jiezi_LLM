{
  "schema_version": "1.0",
  "categories": [
    "loop_limits",
    "cancellation",
    "grants",
    "injection",
    "budget_alignment",
    "user_text"
  ],
  "cases": [
    {
      "id": "limit-parity",
      "category": "loop_limits",
      "input": "比較 limits、contract 與 loop 的上限是否一致且不可變",
      "expected": {"all_equal": true, "immutable": true},
      "synthetic": true
    },
    {
      "id": "call-cap",
      "category": "loop_limits",
      "input": "模型一次提出超過上限的唯讀工具呼叫",
      "expected": {"max_calls": 3, "skipped": 2},
      "synthetic": true
    },
    {
      "id": "timeout-fail-closed",
      "category": "loop_limits",
      "input": "工具呼叫逾時，應回報錯誤而不是卡住或放寬限制",
      "expected": {"error_contains": "timed out", "mcp_calls": 1},
      "synthetic": true
    },
    {
      "id": "result-truncate",
      "category": "loop_limits",
      "input": "工具結果超過 result_chars，應截斷並標明",
      "expected": {"marker": "以下省略"},
      "synthetic": true
    },
    {
      "id": "old-result-shrink",
      "category": "loop_limits",
      "input": "上下文預算不足時，較舊的工具結果應縮短",
      "expected": {"marker": "較早的結果已縮短"},
      "synthetic": true
    },
    {
      "id": "real-child-cancel",
      "category": "cancellation",
      "input": "真實 MCP 子行程必須在一秒內中止",
      "expected": {"max_seconds": 1.0},
      "synthetic": true
    },
    {
      "id": "revoke-after-grant",
      "category": "grants",
      "input": "撤銷授權後，同一資料夾不得再讀取",
